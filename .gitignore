# Dependencies
node_modules/

# Build output
dist/
build/
*.exe

# Local databases — never commit billing data
#
# Anchored to the backend. A bare `data/` matches any directory of that name at
# any depth, which silently excluded every Flutter feature's data/ folder — the
# models and repositories the app will not compile without.
/backend/data/
*.db
*.db-shm
*.db-wal

# Secrets
.env
.env.local
*.local

# Flutter
desktop/.dart_tool/
desktop/.flutter-plugins
desktop/.flutter-plugins-dependencies
desktop/build/
desktop/windows/flutter/ephemeral/
desktop/*.iml

# Editor and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log

# Built by scripts/bundle.mjs — 177 MB of Node runtime and native modules.
backend/dist-bundle/
