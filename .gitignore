# Dependencies
node_modules/

# Build output
dist/
build/
*.exe

# Local databases — never commit billing data
#
# Anchored to the backend. A bare `data/` matches any directory of that name at
# any depth, which silently excluded every Flutter feature's data/ folder — the
# models and repositories the app will not compile without.
/backend/data/
*.db
*.db-shm
*.db-wal

# Secrets
.env
.env.local
*.local

# Flutter
desktop/.dart_tool/
desktop/.flutter-plugins
desktop/.flutter-plugins-dependencies
desktop/build/
desktop/windows/flutter/ephemeral/
desktop/*.iml

# Editor and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log

# Built by scripts/bundle.mjs — 177 MB of Node runtime and native modules.
backend/dist-bundle/

# Staged installer input — build.ps1 bakes the connection string into a copy here.
installer/staging/

# Built installers.
dist/

# The service wrapper is vendored deliberately — without it the backend cannot
# run as a Windows service. See installer/vendor/README.md.
!installer/vendor/*.exe

# Database backups taken before a wipe. Trading data - never committed.
backups/

# Local database backups taken before a destructive change. Never committed:
# they hold real trading data.
.backups/
